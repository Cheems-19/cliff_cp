# ─────────────────────────────────────────────────────────────
# cliff-cp .gitignore
# 放到仓库根目录。设计原则：**代码与可复现的小体积结果进仓库；缓存、日志、
# 服务器运维脚本、超大二进制排除**。
# ─────────────────────────────────────────────────────────────

# ── 1. 超大二进制 / 环境缓存（必须排除：单个 wheel 可达数百 MB）──
wheels_cu121/
wheels_cu124/
*.whl
*.tar.bz2

# ── 2. 项目虚拟环境 ──
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ── 3. 服务器运维脚本：与科学复现无关，且硬编码服务器路径/用户名 ──
remote/

# ── 4. 运行日志（含服务器绝对路径，可能泄露环境信息）──
logs/
*.log

# ── 5. 中间抓取/探测产物 ──
_srv_*.txt
_ssh_probe.txt
_csvheads.txt
_scratch/
*.bak

# ── 6. 系统文件 ──
.DS_Store
Thumbs.db
desktop.ini

# ── 7. 本地编辑器/工具 ──
.vscode/
.idea/
*.swp

# ─────────────────────────────────────────────────────────────
# 说明：以下内容**应当进入仓库**（不要排除）——
#   src/cliffcp/          核心库
#   scripts/              分析/绘图（发布前需 sanitize_check）
#   results_*/**.csv      汇总结果表（单个均 < 100 MB）
#   results_ecfp_abl/dump/*.csv.gz   分子级记录（复现 Fig 11/12 的原料）
#   figures/  figures_submission/     图件（PNG / 600 dpi TIFF / 矢量 PDF）
#   requirements.txt  CITATION.cff  LICENSE  README.md
#   预注册_分析计划.md    预注册文档（公开可增强可信度）
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# 2026-09-24 增补：未发表稿件与内部工作文档（不进公开仓库）
# ─────────────────────────────────────────────────────────────
共形预测*.docx
共形预测*.pdf
SI_v1.*
论文*.md
figures/论文全文_v1.html
manuscript_en_*.md
摘要_多版本.md
与江老师对齐_贡献定位备忘录.md
投稿打包清单.md
参考文献.md
PHASE*.md
清理清单_*.md

# ─────────────────────────────────────────────────────────────
# 2026-09-24 增补：临时/隔离/工具缓存/中转包
# ─────────────────────────────────────────────────────────────
*.tar.gz
*.tar
_qa_*
_session_tmp/
.tmp_pkgs/
_trash_*/
archive/
nohup.out
*.orig
